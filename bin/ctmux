#!/usr/bin/env bash
# ctmux — wrapper around cmux's "Remote tmux" (tmux -CC control mode) feature,
# looped back to the LOCAL tmux server over SSH to localhost. Gives cmux's
# native split/tab/selection UI over your EXISTING tmux sessions.
#
# Why SSH to localhost: cmux's control-mode integration is built exclusively
# as an SSH feature (their own naming choice — the protocol itself doesn't
# care local vs remote; plain drag = native selection either way, Shift only
# needed when the app inside a pane captures the mouse itself). Looping it to
# 127.0.0.1 is the only way to get real window->tab / pane->split mapping
# without changing anything about the tmux server: rig/resurrect/continuum/
# tg/Moshi all keep working unchanged — this just adds another client.
#
# The "Remote tmux" beta flag has no cmux.json key, but it IS a plain
# UserDefaults key (bundle id com.cmuxterm.app, key
# remoteTmux.beta.enabled) read synchronously per call — ctmux flips it
# itself the first time it hits the "disabled" error, no GUI click needed.
#
# Usage:
#   ctmux            ensure the mirror is up, launch cmux (and cmux itself,
#                     since it launches on demand — see ensure_cmux_running)
#   ctmux ls          fzf picker over session:window pairs; Enter mirrors
#                     and focuses that SESSION (window-level focus inside a
#                     mirrored session isn't wired up yet); pick
#                     "+ new session" to create one
#   ctmux new [name]  create a new tmux session (auto-named if omitted),
#                     ensure the mirror, focus it
#   ctmux ensure      idempotent mirror-check only, no picker (still opens
#                     cmux if it isn't running — the login LaunchAgent relies
#                     on this to bring cmux up automatically)
#   ctmux resume [--dry-run] [--surface REF]...
#                     re-run `cmux restore` in panes where cmux's auto-resume
#                     failed (auth_required, tmux not up yet); ensure and bare
#                     ctmux do this too once they have a working password
set -euo pipefail

# launchd (the login LaunchAgent) runs with a minimal PATH that lacks
# Homebrew's bin dirs, where tmux/cmux/fzf/python3 actually live here. Only
# the missing ones are prepended, so a caller's own PATH order (and the test
# suite's stub dir) keeps precedence.
for _dir in /usr/local/bin /opt/homebrew/sbin /opt/homebrew/bin; do
	case ":$PATH:" in *":$_dir:"*) ;; *) PATH="$_dir:$PATH" ;; esac
done
unset _dir
export PATH

CMUX_CFG="$HOME/.config/cmux/cmux.json"
RIG_CFG="$HOME/.config/rig/config.yaml"
CMUX_BUNDLE_ID="com.cmuxterm.app"
# Set by ensure_socket_auth, consumed by cx() via dynamic scope — every path
# that calls cx() must go through ensure_socket_auth (or otherwise assign
# CMUX_PW) first. Initialized empty so `set -u`-style callers never see
# "unbound variable" even before that happens.
CMUX_PW=""

have() { command -v "$1" >/dev/null 2>&1; }

# The canonical tmux session name, sourced from rig's own anti_sprawl config
# (tmux.anti_sprawl.session in rig/config.yaml — the same value
# ~/.config/rig/tmux/tmux-attach.sh uses) so this never drifts from rig's.
canonical_session() {
	python3 - "$RIG_CFG" <<'PY' 2>/dev/null || echo main
import sys
try:
	import yaml
	data = yaml.safe_load(open(sys.argv[1]))
	name = data.get("tmux", {}).get("anti_sprawl", {}).get("session")
	print(name or "main")
except Exception:
	print("main")
PY
}

# One parser for cmux.json, two modes:
#   read  print automation.socketPassword; exit 1 (silently) if it's unset
#         or the file is unreadable
#   heal  the same, but if socketControlMode is "password" and socketPassword
#         is missing, generate a password, write it back and exit
#         $CMUX_CFG_HEALED; on anything it can't fix, print ONE actionable
#         line to stderr and exit 1
# The password only ever goes to stdout (captured into CMUX_PW), never stderr.
#
# heal is a workaround for upstream https://github.com/manaflow-ai/cmux/issues/8372:
# cmux's app launch rewrites cmux.json keeping socketControlMode=password but
# dropping socketPassword, which locks every password-auth socket client out
# (auth_required) — after a reboot that includes cmux's own auto-resumed
# `cmux restore tmux main`. Remove heal mode once that bug is fixed. It always
# GENERATES a fresh password and never restores one from cmux's cmux.*.bak
# backups: a password that sat in a backup file has to be treated as leaked.
#
# JSONC comment-stripping is line-anchored (`^\s*//`), so a *value* that
# happens to start a line with `//` would be stripped too — not reachable
# with hex-generated passwords (never start with `//`), but a real limitation
# of this parser in general; don't put arbitrary strings starting `//` in
# cmux.json values. A healed file is written back as plain JSON (comments
# dropped, every key kept), which is also what cmux itself writes.
CMUX_CFG_HEALED=10
cmux_cfg() {
	python3 - "$1" "$CMUX_CFG" "$HOME" "$CMUX_CFG_HEALED" <<'PY'
import json, os, re, secrets, sys, tempfile
mode, path, home, healed_rc = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])

def tilde(p):
	for h in (home, os.path.realpath(home)):
		if p.startswith(h + "/"):
			return "~" + p[len(h):]
	return p
shown = tilde(path)

def die(msg):
	if mode == "heal":
		print(f"ctmux: {msg}", file=sys.stderr)
	sys.exit(1)

try:
	with open(path) as f:
		text = f.read()
except FileNotFoundError:
	die(f"{shown} not found — fix: mkdir -p {os.path.dirname(shown)} && echo"
	    f""" '{{"automation":{{"socketControlMode":"password"}}}}' > {shown}, then ctmux ensure (it generates the password)""")
except OSError as e:
	die(f"cannot read {shown} ({e.strerror}) — fix: chmod u+r {shown}, then ctmux ensure")
stripped = re.sub(r'(?m)^\s*//.*$', '', text)
stripped = re.sub(r',(\s*[}\]])', r'\1', stripped)
try:
	data = json.loads(stripped)
except ValueError:
	die(f"{shown} is not valid JSON(C) — fix: cmux config check, correct the file, then ctmux ensure")
automation = data.get("automation", {}) if isinstance(data, dict) else None
if not isinstance(automation, dict):
	die(f"{shown} has no automation object at its top level — fix: cmux config check, correct the file, then ctmux ensure")

pw = automation.get("socketPassword") or ""
if pw:
	print(pw)
	sys.exit(0)
if mode != "heal":
	sys.exit(1)
if automation.get("socketControlMode") != "password":
	die(f'{shown} has no automation.socketPassword and socketControlMode is not "password"'
	    ' — fix: set automation.socketControlMode to "password" in it, then ctmux ensure (it generates the password)')

pw = secrets.token_hex(24)
automation["socketPassword"] = pw
target = os.path.realpath(path)  # keep a dotfiles symlink a symlink
tmp = None
try:
	fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".cmux.json.")
	with os.fdopen(fd, "w") as f:
		os.fchmod(f.fileno(), 0o600)
		json.dump(data, f, indent=2)
		f.write("\n")
		f.flush()
		os.fsync(f.fileno())
	os.replace(tmp, target)
except OSError as e:
	if tmp and os.path.exists(tmp):
		os.unlink(tmp)
	# Name the real file's dir: for a dotfiles symlink that's where the
	# write needs permission, not ~/.config/cmux.
	real = tilde(target)
	die(f"cannot write {shown} to restore its missing socketPassword ({e.strerror})"
	    f" — fix: chmod u+w {os.path.dirname(real)} {real}, then ctmux ensure")
print(pw)
sys.exit(healed_rc)
PY
}

read_cmux_password() { cmux_cfg read; }

cx() { CMUX_SOCKET_PASSWORD="$CMUX_PW" command cmux "$@"; }

check_sshd() {
	if ! nc -z -w1 localhost 22 2>/dev/null; then
		cat >&2 <<'EOF'
ctmux: SSH (Remote Login) is not reachable on localhost:22.
Fix: System Settings > General > Sharing > Remote Login > On.
Security note: this binds sshd on ALL interfaces, not just loopback, even
though ctmux only ever talks to 127.0.0.1. If this machine is ever on an
untrusted network, restrict it: add "ListenAddress 127.0.0.1" to
/etc/ssh/sshd_config (or the modern /etc/ssh/sshd_config.d/ drop-in) and keep
key-only auth (PasswordAuthentication no) — ctmux's own localhost check still
passes either way.
EOF
		return 1
	fi
	if ! ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new localhost true 2>/dev/null; then
		if ssh -vo BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new localhost true 2>&1 | grep -qi "host key verification failed"; then
			cat >&2 <<'EOF'
ctmux: SSH to localhost failed host-key verification. Fix (loopback only,
safe to auto-accept):
  ssh-keyscan -H localhost >> ~/.ssh/known_hosts
EOF
		else
			cat >&2 <<'EOF'
ctmux: SSH to localhost needs a key-based login (no password prompt allowed
for an automated mirror). Fix — restrict the key to loopback only, so a
leaked private key can't be used to log in remotely:
  printf 'from="127.0.0.1,::1" %s ctmux-loopback\n' "$(cat ~/.ssh/id_ed25519.pub | awk '{print $1" "$2}')" >> ~/.ssh/authorized_keys
  chmod 600 ~/.ssh/authorized_keys
EOF
		fi
		return 1
	fi
}

# Bounded wait for rig's own tmux-boot LaunchAgent to have started the server
# and created the canonical session — avoids a login-time race where ctmux's
# LaunchAgent fires before rig's does and mirrors nothing. Only meaningful at
# login time (the bare `ensure` path); irrelevant once a specific session is
# already known to exist (new_session skips it — see ensure_mirror).
wait_for_tmux_session() {
	local session="$1"
	for _ in $(seq 1 60); do
		tmux has-session -t "=$session" 2>/dev/null && return 0
		sleep 1
	done
	echo "ctmux: tmux session '$session' never appeared after 60s wait." >&2
	return 1
}

# The cmux *app*, matched by its bundle executable path. `-a` matters: macOS
# pgrep silently skips the caller and all of its ancestors, and every shell
# in a cmux terminal descends from the app, so a plain `pgrep -x cmux` never
# sees it from there (https://github.com/alex-mextner/ctmux-cli/issues/3).
# Matching the bundle path rather than the name also ignores `cmux` CLI
# processes (Contents/Resources/bin/cmux), which share the process name.
cmux_app_running() { pgrep -af 'cmux\.app/Contents/MacOS/cmux( |$)' >/dev/null 2>&1; }

ensure_cmux_running() {
	cmux_app_running && return 0
	open -a cmux
	for _ in $(seq 1 20); do
		cmux_app_running && return 0
		sleep 0.3
	done
	echo "ctmux: cmux did not start in time" >&2
	return 1
}

# Cross-process lock for the sections where two ctmux runs must not overlap
# (the socket-password heal below, and the stalled-pane resume). Right after a
# reboot the login agent and a manual `ctmux` can both see the password
# missing: whoever holds the lock generates, loads and verifies a password,
# and the next run then finds it in cmux.json and only pings (without the
# lock each would write its own random password and the first one's ping
# would fail with a false "rejected" — https://github.com/alex-mextner/ctmux-cli/issues/4).
# It is an flock on fd 9 (a fixed number: macOS's /bin/bash 3.2 has no
# `{var}>` fd allocation): the kernel drops it when its holder dies, so a
# ctmux that dies mid-section leaves no stale lock behind. For that to hold,
# no child of a locked section may inherit fd 9 — a stuck `cmux` child would
# keep the lock alive after its parent died — so every command run there
# (cmux, sleep, seq) gets `9>&-`.
# An fd 9 inherited from the caller is simply replaced (this process's copy
# only). Never fatal — if the lock file can't be opened (unwritable or missing
# config dir), python3 is missing, or a
# holder hangs past LOCK_WAIT_S (far longer than a healthy section takes: 20
# rounds of a ~0.3 s pause plus a ping), the run goes on unlocked and the
# section reports its own actionable error as before. A hung holder must not
# lock every later ctmux out. lock_take never returns non-zero (callers run
# under `set -e`); one lock at a time, always paired with lock_release.
LOCK_WAIT_S=90
LOCK_HELD=""
# LOCK_ACQUIRED: 1 only when the flock really is ours. The heal goes on
# without it (see above); the resume does not, since two unlocked scans would
# both type into the same pane.
LOCK_ACQUIRED=""
lock_take() { # $1: lock file, $2: seconds to wait for it (default LOCK_WAIT_S)
	LOCK_ACQUIRED=""
	[ -z "$LOCK_HELD" ] || { LOCK_ACQUIRED=1; return 0; }
	{ exec 9>>"$1"; } 2>/dev/null || return 0
	LOCK_HELD=1
	python3 - "${2:-$LOCK_WAIT_S}" <<'PY' 2>/dev/null && LOCK_ACQUIRED=1 || true
import fcntl, sys, time
deadline = time.monotonic() + float(sys.argv[1])
while True:
	try:
		fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
		break
	except OSError:
		if time.monotonic() > deadline:
			sys.exit(1)
		time.sleep(0.1)
PY
}
lock_release() {
	[ -z "$LOCK_HELD" ] || exec 9>&-
	LOCK_HELD=""
	LOCK_ACQUIRED=""
}

# Every failure prints exactly one actionable line (what is wrong + the fix
# command) instead of cmux's raw auth_required error.
ensure_socket_auth_locked() {
	local rc out="" reload_failed=""
	for _ in $(seq 1 20 9>&-); do
		# Re-read every round: right after `open -a cmux` the app may still
		# be about to drop the password ctmux just read (#8372 happens
		# during its launch).
		rc=0
		CMUX_PW=$(cmux_cfg heal 9>&-) || rc=$?
		if [ "$rc" -eq "$CMUX_CFG_HEALED" ]; then
			# cmux watches cmux.json and normally picks the new password up
			# by itself; reload-config makes sure. Not fatal by itself: the
			# ping is what proves cmux accepts the password. (No fallback to a
			# cmux terminal's socket capability: in password mode with the
			# password gone, cmux 0.64.25 rejects that too.)
			reload_failed=""
			cx reload-config >/dev/null 2>&1 9>&- || reload_failed=1
		elif [ "$rc" -ne 0 ]; then
			return 1 # cmux_cfg already printed the actionable line
		fi
		out=$(cx ping 2>&1 9>&-) && return 0
		sleep 0.3 9>&-
	done
	# Relaunching makes cmux load cmux.json afresh; if the launch drops the
	# password again, the next ctmux ensure heals it.
	local relaunch="quit and reopen cmux (osascript -e 'quit app \"cmux\"'; open -a cmux), then ctmux ensure"
	if [ -n "$reload_failed" ]; then
		echo "ctmux: wrote a new automation.socketPassword to ~/.config/cmux/cmux.json, but cmux hasn't picked it up and \`cmux reload-config\` failed — fix: $relaunch" >&2
	elif printf '%s' "$out" | grep -qiE 'auth_required|auth_unconfigured|authentication required|invalid password|no socket password' 9>&-; then
		echo "ctmux: cmux rejected the socket password in ~/.config/cmux/cmux.json (it is running with a different one) — fix: $relaunch" >&2
	else
		echo "ctmux: cmux socket not reachable (\`cmux ping\` keeps failing) — fix: open -a cmux, wait for its window, then ctmux ensure" >&2
	fi
	return 1
}

ensure_socket_auth() {
	local rc=0
	lock_take "$(dirname "$CMUX_CFG")/.ctmux-heal.lock"
	ensure_socket_auth_locked || rc=$?
	lock_release
	return "$rc"
}

# cmux's auto-resume types `cmux restore <kind> <id>` into every restored
# terminal during the app launch. That launch also drops the socket password
# (cmux#8372), so the command fails once with auth_required — and for a
# `tmux` binding it can run before the tmux server is back — and the pane sits
# at a shell showing the error (https://github.com/alex-mextner/ctmux-cli/issues/5).
# Once ctmux has a working password (and, for ensure, tmux is up) it re-runs
# the restore in exactly those panes, by typing `cmux restore --surface REF`.
#
# A pane is touched only when ALL of these hold:
#   - cmux lists its surface as a terminal and reports nothing running in it
#     (no process, no foreground process group): an idle shell, never a tmux
#     client or an agent;
#   - the surface has a resume binding (cmux's own record, which also decides
#     WHAT is restored: ctmux never types a command it read off the screen);
#   - the newest output on its screen is the typed `cmux restore <kind> <id>`
#     of that very binding followed by an auth error (a tmux binding also by
#     tmux's "no server"/"can't find session"), then at most a prompt;
#   - for an agent binding, no process anywhere has the session id in its
#     command line: resuming a session that runs elsewhere would put a second
#     writer on it;
#   - the previous line is not ctmux's own `--surface` retry (no retry loop).
# Options: --dry-run (report only), --surface REF (limit to that pane, repeat
# for more), --explicit (the `ctmux resume` subcommand: report problems).
# Prints one line per pane acted on or deliberately skipped.
scan_stalled_surfaces() {
	CMUX_PW="$CMUX_PW" python3 - "$@" <<'PY'
import hashlib, json, os, re, subprocess, sys, time

dry_run = explicit = False
only = set()
args = sys.argv[1:]
i = 0
while i < len(args):
	a = args[i]
	if a == "--dry-run":
		dry_run = True
	elif a == "--explicit":
		explicit = True
	elif a == "--surface" and i + 1 < len(args):
		i += 1
		only.add(args[i])
	else:
		print(f"ctmux: unknown resume option '{a}' (try: --dry-run, --surface REF)", file=sys.stderr)
		sys.exit(2)
	i += 1

env = dict(os.environ, CMUX_SOCKET_PASSWORD=os.environ.pop("CMUX_PW", ""))

def cmux(*a):
	try:
		p = subprocess.run(["cmux", *a], env=env, capture_output=True, text=True, timeout=20)
	except (OSError, subprocess.SubprocessError):
		return None
	return p.stdout if p.returncode == 0 else None

def jcmux(*a):
	out = cmux(*a)
	try:
		return json.loads(out) if out else None
	except ValueError:
		return None

def walk(x, pred, out):
	if isinstance(x, dict):
		if pred(x):
			out.append(x)
		for v in x.values():
			walk(v, pred, out)
	elif isinstance(x, list):
		for v in x:
			walk(v, pred, out)
	return out

tree = jcmux("tree", "--all", "--json")
top = jcmux("--json", "top", "--all", "--processes")
if tree is None or top is None:
	if explicit:
		print("ctmux: cmux didn't list its terminals (cmux tree/top failed)", file=sys.stderr)
		sys.exit(1)
	sys.exit(0)

# Idle = cmux lists the surface and reports nothing running in it. A surface
# cmux didn't report on is not idle (fail closed).
def idle_refs(snapshot):
	return {s["ref"] for s in walk(snapshot, lambda d: d.get("kind") == "surface" and isinstance(d.get("ref"), str), [])
	        if not s.get("processes") and not s.get("foreground_pgids")}

idle = idle_refs(top)
refs = [s["ref"] for s in walk(tree, lambda d: d.get("type") == "terminal" and isinstance(d.get("ref"), str), [])]

REF = re.compile(r"surface:[0-9]+")
TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._@:-]{0,127}")
AUTH = re.compile(r"auth_required|authentication required|no socket password is configured", re.I)
TMUX_DOWN = re.compile(r"no server running|error connecting to|failed to connect to server|no sessions|can't find session", re.I)

PROMPT = re.compile(r"[>$%#❯➜»]\s*$")
NOT_TOKEN_BEFORE = r"(?<![A-Za-z0-9._@:-])"
NOT_TOKEN_AFTER = r"(?![A-Za-z0-9._@:-])"

def newest_failure(kind, cid, screen):
	"""'stalled', 'retried' (our own retry failed too) or None."""
	lines = [l for l in screen.splitlines() if l.strip()][-8:]
	pats = [AUTH] + ([TMUX_DOWN] if kind == "tmux" else [])
	for n in range(len(lines) - 1, 0, -1):
		if not any(p.search(lines[n]) for p in pats):
			continue
		typed, after = lines[n - 1], lines[n + 1:]
		# After the error: nothing, or one empty prompt (a line ending in a
		# prompt character — text the user has typed there is not an empty one).
		if len(after) > 1 or (after and not PROMPT.search(after[0])):
			return None
		if "cmux restore --surface" in typed:
			return "retried"
		return "stalled" if re.search(NOT_TOKEN_BEFORE + re.escape(f"cmux restore {kind} {cid}") + NOT_TOKEN_AFTER, typed) else None
	return None

# What this tool remembers between runs, in CTMUX_RESUME_MARKER:
#   sent   ref -> hash of the screen it typed the restore into. The typed
#          command shows up on the screen only once cmux has echoed it; until
#          then (or forever, if it never does) the pane still looks like the
#          original failure, and the unchanged screen is what says "already
#          handled". Any change of the screen (the echo, a new launch) ends it.
#   claims "<kind> <id>" -> epoch. The resumed agent may not be in ps yet when
#          the next run starts, so the session stays claimed for a while.
CLAIM_FOR_S = 900
ECHO_WAIT_S = float(os.environ.get("CTMUX_RESUME_ECHO_WAIT_S") or 10)
marker_path = os.environ.get("CTMUX_RESUME_MARKER") or ""
now = time.time()
sent, claims = {}, {}
try:
	data = json.load(open(marker_path))
	sent = {str(k): str(v) for k, v in data.get("sent", {}).items()}
	claims = {str(k): float(v) for k, v in data.get("claims", {}).items()}
except (OSError, ValueError, AttributeError, TypeError):
	pass

def save_marker():
	if not marker_path:
		return
	data = {"sent": sent, "claims": {k: v for k, v in claims.items() if now - v < CLAIM_FOR_S}}
	try:
		tmp = f"{marker_path}.{os.getpid()}"
		with open(tmp, "w") as f:
			json.dump(data, f)
		os.replace(tmp, marker_path)
	except OSError:
		pass

def screen_hash(text):
	return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()

def read_screen(ref):
	return cmux("read-screen", "--surface", ref, "--lines", "30") or ""

procs = None
pending = []
acted = reported = False
for ref in refs:
	if only and ref not in only:
		continue
	if not REF.fullmatch(ref) or ref not in idle:
		continue
	rec = (jcmux("surface", "resume", "show", "--json", "--surface", ref) or {}).get("restore_record")
	if not isinstance(rec, dict):
		continue
	kind, cid = str(rec.get("kind") or ""), str(rec.get("checkpoint_id") or "")
	if not TOKEN.fullmatch(kind) or not TOKEN.fullmatch(cid):
		continue
	screen = read_screen(ref)
	state = newest_failure(kind, cid, screen)
	if ref in sent and sent[ref] != screen_hash(screen):
		# The screen moved on (the echo of the typed command, or a new launch):
		# the marker has done its job.
		del sent[ref]
		save_marker()
	if state is None:
		continue
	if state == "retried":
		print(f"ctmux: {ref}: the re-run of `cmux restore {kind} {cid}` failed too — run it by hand in that pane")
		reported = True
		continue
	if ref in sent:
		print(f"ctmux: {ref}: the restore was typed earlier and has not shown up on the screen — leaving the pane alone")
		reported = True
		continue
	if kind != "tmux":
		if procs is None:
			try:
				procs = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True, timeout=20).stdout
			except (OSError, subprocess.SubprocessError):
				procs = ""
		if re.search(r"(?<![A-Za-z0-9])" + re.escape(cid) + r"(?![A-Za-z0-9])", procs):
			print(f"ctmux: {ref}: {kind} session {cid} is still running elsewhere — not resuming it a second time")
			reported = True
			continue
		# The ps snapshot predates what this scan (or the previous run) typed,
		# and the resumed process may not be in it yet: a second pane bound to
		# the same session must not get a second writer on it either.
		if now - claims.get(f"{kind} {cid}", 0) < CLAIM_FOR_S:
			print(f"ctmux: {ref}: {kind} session {cid} is already being resumed in another pane — not resuming it twice")
			reported = True
			continue
	if not dry_run:
		# The snapshot above is seconds old by now (other panes, the echo
		# waits): the pane may have gone busy, or the user may have used it.
		# Look once more right before typing. cmux has no conditional send, so
		# this narrows the window to a few milliseconds; it cannot close it.
		fresh = jcmux("--json", "top", "--all", "--processes")
		screen = read_screen(ref)
		if fresh is None or ref not in idle_refs(fresh) or newest_failure(kind, cid, screen) != "stalled":
			print(f"ctmux: {ref}: the pane changed while ctmux was looking at it — leaving it alone")
			reported = True
			continue
	acted = True
	if kind != "tmux":
		claims[f"{kind} {cid}"] = now
	if dry_run:
		print(f"ctmux: would re-run the failed `cmux restore {kind} {cid}` in {ref}")
	else:
		# Marked before typing, so that a run which finds the screen still
		# showing the old failure (the echo is slow, or never comes) leaves the
		# pane alone instead of typing the restore again.
		sent[ref] = screen_hash(screen)
		save_marker()
		if cmux("send", "--surface", ref, f"cmux restore --surface {ref}\\n") is None:
			sent.pop(ref, None)
			claims.pop(f"{kind} {cid}", None)
			save_marker()
			print(f"ctmux: {ref}: couldn't type the restore — run `cmux restore {kind} {cid}` in that pane")
			continue
		print(f"ctmux: re-ran the failed `cmux restore {kind} {cid}` in {ref}")
		pending.append(ref)
# Don't let another run in before the typed commands are on the screens: that
# run then sees them and leaves the panes alone. One shared deadline, not one
# per pane.
deadline = time.monotonic() + ECHO_WAIT_S
while pending and time.monotonic() < deadline:
	pending = [r for r in pending if "cmux restore --surface" not in read_screen(r)]
	if pending:
		time.sleep(0.15)
if explicit and not acted and not reported:
	print("ctmux: no pane is waiting for a failed restore")
PY
}

# Serialized: two overlapping runs (the login agent, a manual ctmux, the
# cmux.json watcher) must not both type the restore into the same pane.
resume_stalled_surfaces() {
	# Each pane acted on may wait for its echo (up to 10 s), so a long wait for
	# the lock is legitimate here; unlocked running is only the last resort.
	local rc=0
	lock_take "$(dirname "$CMUX_CFG")/.ctmux-resume.lock" 300
	if [ -z "$LOCK_ACQUIRED" ]; then
		# Two unlocked scans could both type into the same pane: do nothing.
		lock_release
		echo "ctmux: couldn't take the resume lock (another resume is still running, or ${CMUX_CFG%/*} isn't writable) — skipped the re-run of failed restores; run ctmux resume again" >&2
		return 1
	fi
	CTMUX_RESUME_MARKER="$(dirname "$CMUX_CFG")/.ctmux-resume.sent" scan_stalled_surfaces "$@" || rc=$?
	lock_release
	return "$rc"
}

# True once a control-mode client is actually attached and mirroring $1.
# Builds the RPC payload with json.dumps (not string interpolation): a
# session name containing a literal `"` would otherwise corrupt the JSON —
# or, worse, inject an extra key if cmux's parser is lenient about duplicate
# keys.
mirror_active() {
	local session="$1" out payload
	payload=$(python3 -c 'import json, sys; print(json.dumps({"host": "localhost", "session": sys.argv[1]}))' "$session")
	out=$(cx rpc remote.tmux.state "$payload" 2>/dev/null) || return 1
	python3 - "$out" <<'PY' 2>/dev/null
import json, sys
try:
	d = json.loads(sys.argv[1])
except Exception:
	sys.exit(1)
sys.exit(0 if d.get("attached") and d.get("started") else 1)
PY
}

enable_beta_flag() {
	defaults write "$CMUX_BUNDLE_ID" remoteTmux.beta.enabled -bool true 2>/dev/null
}

# Idempotent (~1s, proven safe to re-run): always calls `ssh-tmux localhost`
# rather than trusting a cache, so it also picks up sessions created outside
# ctmux (a fresh window from rig/resurrect at boot, a session made by hand).
#
# $1 (optional): the session to confirm mirrored afterward. Omit it for the
# login-race path (bare `ctmux`/`ctmux ensure`), where ctmux also waits for
# the canonical session to exist before mirroring at all — that wait is
# meaningless for a session that was JUST created (new_session passes its own
# name and skips it; waiting for an unrelated canonical session to appear
# would wrongly block or fail session creation on a machine that doesn't run
# it).
ensure_mirror() {
	local target="${1:-}" canonical
	canonical=$(canonical_session)
	check_sshd || return 1
	if [ -z "$target" ]; then
		wait_for_tmux_session "$canonical" || return 1
		target="$canonical"
	fi
	ensure_cmux_running || return 1
	ensure_socket_auth || return 1
	# Panes cmux auto-resumed before the heal (and before tmux was up) are
	# waiting for this; see resume_stalled_surfaces. Only for the commands that
	# mean "bring everything back" (ensure, bare ctmux), not ls/new.
	[ -z "${CTMUX_RESUME:-}" ] || resume_stalled_surfaces || true

	local out
	if out=$(cx ssh-tmux localhost --no-focus 2>&1); then
		mirror_active "$target" || echo "ctmux: ssh-tmux reported success but $target isn't confirmed attached yet (state may lag briefly)." >&2
		return 0
	fi

	if printf '%s' "$out" | grep -qi "remote tmux beta is disabled"; then
		enable_beta_flag
		if ! out=$(cx ssh-tmux localhost --no-focus 2>&1); then
			echo "ctmux: still failing after enabling the beta flag: $out" >&2
			return 1
		fi
		mirror_active "$target" || echo "ctmux: ssh-tmux reported success but $target isn't confirmed attached yet (state may lag briefly)." >&2
		return 0
	fi

	# Any other failure is real — do not pattern-match hopeful substrings
	# ("already"/"mirrored") in an error we haven't actually observed cmux
	# produce; that would mask a genuine failure (connection refused, host
	# key mismatch, ...) as success.
	echo "ctmux: $out" >&2
	return 1
}

# Focuses the cmux workspace mirroring $1 (a tmux session name) — cmux side
# ONLY. Deliberately does not touch tmux's own current-window state: that is
# shared by every attached client, including your live outer terminal, and
# `tmux select-window` would yank its view out from under you. Window-level
# (tab-level) focus inside the workspace isn't wired up yet — this gets you
# to the right session, not necessarily the exact window within it.
#
# Bounded retry: the workspace for a session created moments ago may not
# exist yet even though ssh-tmux itself reported success (state lags
# briefly, same as mirror_active). A silent single-shot lookup would
# otherwise no-op without any feedback.
focus_session_workspace() {
	local session="$1" ref=""
	# CMUX_PW is expected to already be set by ensure_socket_auth (every
	# real caller reaches this via launch_and_focus -> ensure_mirror ->
	# ensure_socket_auth first, in the same process). Re-derive it only as
	# a defensive fallback for a future caller that skips that path.
	if [ -z "${CMUX_PW:-}" ] && ! CMUX_PW=$(read_cmux_password); then
		return 0
	fi
	for _ in $(seq 1 20); do
		ref=$(cx workspace list --json 2>/dev/null | python3 -c "
import json, sys
target = sys.argv[1]
try:
	d = json.load(sys.stdin)
	for w in d.get('workspaces', []):
		if w.get('title') == target:
			print(w['ref'])
			break
except Exception:
	pass
" "$session" 2>/dev/null) || true
		[ -n "$ref" ] && break
		sleep 0.3
	done
	if [ -z "$ref" ]; then
		echo "ctmux: couldn't find a cmux workspace for session '$session' yet — it may still be mirroring; try 'ctmux ls' in a moment." >&2
		return 0
	fi
	cx workspace select "$ref" >/dev/null 2>&1 || true
}

launch_and_focus() {
	local target="$1"
	ensure_mirror "$target"
	open -a cmux
	focus_session_workspace "$target"
}

new_session() {
	local name="${1:-}"
	if [ -z "$name" ]; then
		name="ws-$(date +%H%M%S)"
	fi
	if tmux has-session -t "=$name" 2>/dev/null; then
		echo "ctmux: session '$name' already exists, attaching to it." >&2
	else
		tmux new-session -d -s "$name" -c "$HOME"
	fi
	launch_and_focus "$name"
}

picker() {
	have fzf || { echo "ctmux: fzf not found (brew install fzf)" >&2; exit 1; }
	# Single tmux call across all sessions, tab-delimited so a session name
	# with spaces (tmux allows them) doesn't get word-split by a `for x in
	# $(...)` loop or misparsed by an awk-on-spaces field split later.
	local rows sel
	rows=$(tmux list-windows -a -F $'#{session_name}\t#{window_index} (#{window_name})' 2>/dev/null) || rows=""
	sel=$({ [ -n "$rows" ] && printf '%s\n' "$rows"; printf '+ new session\n'; } | fzf --prompt='ctmux> ' --height=50% --reverse \
		--header='enter: mirror + focus this session in cmux') || exit 0
	[ -n "$sel" ] || exit 0
	if [ "$sel" = "+ new session" ]; then
		printf 'new session name: '
		local name=""
		read -r name || true
		new_session "$name"
		return
	fi
	local session
	IFS=$'\t' read -r session _ <<<"$sel"
	launch_and_focus "$session"
}

# Sourceable (tests load the functions): dispatch only when executed.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

cmd="${1:-}"
case "$cmd" in
	ls)
		picker
		;;
	new)
		shift || true
		new_session "${1:-}"
		;;
	ensure)
		CTMUX_RESUME=1 ensure_mirror
		;;
	resume)
		shift || true
		cmux_app_running || { echo "ctmux: cmux is not running — fix: open -a cmux, then ctmux resume" >&2; exit 1; }
		ensure_socket_auth || exit 1
		resume_stalled_surfaces --explicit "$@"
		;;
	"")
		CTMUX_RESUME=1 ensure_mirror
		open -a cmux
		;;
	*)
		echo "ctmux: unknown command '$cmd' (try: ls, new [name], ensure, resume [--dry-run] [--surface REF], or no args)" >&2
		exit 1
		;;
esac
